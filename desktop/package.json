{
  "name": "autosell-v3-desktop",
  "productName": "Autosell V3",
  "version": "3.0.1",
  "description": "Autosell V3 desktop delivery console",
  "author": "Autosell V3",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.js",
    "test": "node --test test/*.test.js",
    "test:runtime": "node scripts/test-runtime.js",
    "test:installed": "node scripts/test-installed.js",
    "test:update": "node scripts/test-update-acceptance.js",
    "build": "npm run prepare:resources && electron-builder --config electron-builder.config.js --win nsis --x64 --publish never",
    "package": "electron-builder --config electron-builder.config.js --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "js-yaml": "4.3.2"
  }
}
